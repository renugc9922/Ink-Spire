# Backend port for local development.
PORT=3001

# Frontend origin allowed by CORS.
# Set this to the deployed Vercel URL in production.
FRONTEND_URL=https://ink-spire-hazel.vercel.app

# Enables the local model fallback path.
# Keep this false on Render unless you deploy a separate inference service.
USE_LOCAL_LLM=false

# Optional local inference server endpoint used when USE_LOCAL_LLM is enabled.
LOCAL_LLM_URL=http://localhost:5000/generate

# Required for Gemini-powered image analysis and cover/title generation.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE