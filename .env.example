# Frontend API base URL used by the Vite app to reach the backend.
# Set this to your deployed backend URL on Render in production.
VITE_API_URL=https://your-backend-service.onrender.com

# Backend server port.
# The backend listens on this port when you run the Node server.
PORT=3001

# Enables the backend's local model fallback path.
# Keep this false for Render unless you deploy a separate local inference service.
USE_LOCAL_LLM=false

# Local inference server endpoint used when USE_LOCAL_LLM is enabled.
# This should point to your local Flask or model server.
LOCAL_LLM_URL=http://localhost:5000/generate

# Allowed frontend origin for CORS in the backend.
# Set this to your deployed frontend URL on Render in production.
FRONTEND_URL=https://your-frontend-service.onrender.com

# Google Gemini API key used for image analysis and cover generation.
# Replace this with your own secret value and never commit a real key.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
